{"repo": {"timestamp": 1783627077000, "version": 20002, "name": "Session F-Droid", "icon": "icon.png", "address": "https://fdroid.getsession.org/fdroid/repo", "description": "Session F-Droid mirror repository"}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "Session Technology Foundation", "categories": ["Phone & SMS"], "suggestedVersionCode": "4525", "issueTracker": "https://github.com/session-foundation/session-android", "license": "Unknown", "name": "Session", "sourceCode": "https://www.github.com/session-foundation/session-android", "summary": "Send messages, not metadata. No ads or trackers \u2014 only private messaging.", "webSite": "https://getsession.org/", "added": 1775529179000, "packageName": "network.loki.messenger", "lastUpdated": 1783627077000, "localized": {"en-US": {"description": "Session is a new breed of encrypted private messenger, built on a unique network of user-operated servers spread all over the world. With no central servers, Session can\u2019t leak or sell your data. You don't need a phone number or email to sign up \u2014 your Session ID can stay completely anonymous. And Session\u2019s private routing protocols keep your messages secret and secure. No one ever knows who you\u2019re talking to, what you\u2019re saying, or even your IP address.\n\n\u2022 Fully anonymous account creation, no phone number or email required\n\n\u2022 Decentralised server network: No data breaches and no central point of failure\n\n\u2022 No metadata logging: Session doesn't store, track, or log your messaging metadata\n\n\u2022 IP address protection: Device IP addresses are never exposed to the person you're talking to or the servers holding your data\n\n\u2022 Closed groups: Private, end-to-end encrypted group chats for up to 100 people\n\n\u2022 Encrypted attachments: Share voice snippets, photos, and files with Session's security and privacy protections\n\n\u2022 Free and fully open-source: Don\u2019t take our word for it \u2014 check Session's code yourself\n\nSession is free as in free speech, free as in free beer, and free of ads and trackers. Session is built and maintained by the Loki Foundation, Australia\u2019s first privacy tech not-for-profit organisation. Take back your online privacy today \u2014 download Session.\n\nWant to build from source, report a bug, or just take a look at our code? Check out Session on GitHub: https://github.com/session-foundation/session-android", "featureGraphic": "featureGraphic_tDmBSNdMgczKKP-o7HNQ43LbSrXrCANalHDfXUtbIlk=.png", "icon": "icon_NbpUKHfS0yBdFzn9tsG-U1dtV9iVMAdE4nAgwuIx7ZY=.png", "name": "Session - Private Messenger", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png", "6.png", "7.png"], "summary": "Send messages, not metadata. No ads or trackers \u2014 only private messaging."}}}], "packages": {"network.loki.messenger": [{"added": 1783627076000, "apkName": "session-1.33.5-universal-fdroid-release.apk", "hash": "194223272e3ba57bf731f8e791d96cd9af0acf2a4784e62adc17df76bfb6e8ad", "hashType": "sha256", "minSdkVersion": 26, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "network.loki.messenger", "sig": "702dcc50431a18bf79b985819198eab5", "signer": "f2a0ecf70686447d1d6c6cbbf58c42890500ccf41af372ae2099303980824edd", "size": 153849063, "targetSdkVersion": 36, "uses-permission": [["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.BLUETOOTH", null], ["android.permission.BROADCAST_STICKY", null], ["android.permission.CAMERA", null], ["android.permission.DISABLE_KEYGUARD", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_PHONE_CALL", null], ["android.permission.FOREGROUND_SERVICE_MICROPHONE", null], ["android.permission.FOREGROUND_SERVICE_SPECIAL_USE", null], ["android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK", null], ["android.permission.MANAGE_OWN_CALLS", null], ["com.android.launcher.permission.INSTALL_SHORTCUT", null], ["android.permis